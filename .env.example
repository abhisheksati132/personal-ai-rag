# ==========================================
# Personal AI Brain Configuration
# ==========================================

# Base directory paths (optional: defaults to local repository structure)
# BRAIN_DATA_DIR=./data
# BRAIN_DOCUMENTS_DIR=./data/documents
# BRAIN_CHROMA_DIR=./data/chroma_db
# BRAIN_SQLITE_DB_PATH=./data/brain.db

# Ollama LLM & Embedding Settings
# For Native Host: http://127.0.0.1:11434
# For Docker Compose: http://ollama:11434
BRAIN_OLLAMA_BASE_URL=http://127.0.0.1:11434
BRAIN_EMBEDDING_MODEL=nomic-embed-text
BRAIN_LLM_MODEL=llama3.2
BRAIN_LLM_TEMPERATURE=0.1

# Retrieval & Chunking Configuration
BRAIN_SIMILARITY_THRESHOLD=0.40
BRAIN_TOP_K=8
BRAIN_CHUNK_SIZE=1000

BRAIN_CHUNK_OVERLAP=150

# Groq Cloud LLM Fallback (Optional)
# Obtain a free API key at https://console.groq.com/keys
# If left empty, all queries use 100% local Ollama by default
GROQ_API_KEY=
BRAIN_GROQ_MODEL=llama-3.3-70b-versatile
BRAIN_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Web UI Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

